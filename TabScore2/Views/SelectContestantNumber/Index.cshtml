<script>
    var contestantNumber = "";
    var isSubmitted = false;

    function selectContestantNumber(n) {
        if (contestantNumber != "") {
           document.getElementById("tn" + contestantNumber).className = "btn btn-primary btn-lg m-1 px-0";
        }
        document.getElementById("tn" + n).className = "btn btn-warning btn-lg m-1 px-0";
        contestantNumber = n;
        document.getElementById("OKButton").disabled = false;
    }

    function OKButtonClick() {
        if (document.getElementById("OKButton").disabled) return;
        if (!isSubmitted) {
            isSubmitted = true;
            location.href = '@Url.Action("OKButtonClick", "SelectContestantNumber")?contestantNumber=' + contestantNumber + '&confirm=false';
        }
    }
</script>