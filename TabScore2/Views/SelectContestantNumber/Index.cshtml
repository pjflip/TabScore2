@model SelectContestantNumberModel

@if (Model.ConfirmContestantNumber > 0)
{
    <div id="contestantRegisteredModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header text-danger">
                    <p class="modal-title text-center">
                        <h3>@localizer["Warning"]</h3>
                    </p>
                </div>
                <div class="modal-body">
                    <p>@localizer["ErrorContestantRegistered1"] @Model.ConfirmContestantNumber @localizer["ErrorContestantRegistered3"]</p>
                </div>
                <div class="modal-footer" style="justify-content:space-between">
                    <button class="btn btn-lg btn-danger" onclick="modalLogOn()">
                        <span class="icon-check-circle"></span> @localizer["Register"]
                    </button>
                    <button class="btn btn-lg btn-success" data-bs-dismiss="modal">
                        @localizer["Cancel"] <span class="icon-times-circle"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        var contestantRegisteredModal = new bootstrap.Modal(document.getElementById("contestantRegisteredModal"), { backdrop: 'static' });
        contestantRegisteredModal.show();

        function modalLogOn() {
            if (!isSubmitted) {
                isSubmitted = true;
                location.href = '@Url.Action("OKButtonClick", "selectContestantNumber")?contestantNumber=@Model.ConfirmContestantNumber&confirm=true';
            }
        }
    </script>
}

<div class="row mt-4">
    <div class="col-12 text-center">
        <h2>
            @localizer["SelectContestantNumber"]
        </h2>
    </div>
</div>

<div class="row">
    <div class="col-12 text-center p-0">
        @for (int i = 0; i < Model.NumContestants && i < 5; i++)
        {
            <button id="tn@(Model.ContestantNumbers[i])" class="btn btn-primary btn-lg m-1 px-0" style="width:2.5em" ontouchstart="touchAvailable = true; selectContestantNumber('@Model.ContestantNumbers[i]')" onclick="if (!touchAvailable) selectContestantNumber('@Model.ContestantNumbers[i]')">
                @Model.ContestantNumbers[i]
            </button>
        }
    </div>
</div>

