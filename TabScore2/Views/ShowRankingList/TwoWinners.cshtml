@model ShowRankingListModel

<div class="row mt-4">
    <div class="col-12 text-center">
        <h4>
            @localizer["RankingList"]
        </h4>
    </div>
</div>

<div class="row">
    <div class="col-6 p-0">
        <table class="table table-sm table-bordered text-center" style="margin:auto; width:80%">
            <thead class="thead-dark">
                <tr>
                    <th>@localizer["Rank"] @localizer["N"]@localizer["S"]</th>
                    <th>@localizer["Pair"]</th>
                    <th>@localizer["PercentageShort"]</th>
                </tr>
            </thead>
            <tbody id="tableBodyNS">
                @foreach (var Rank in Model)
                {
                    if (Rank.Orientation == "N")
                    {
                        if (Model.ContestantNumberNorth == Rank.ContestantNumber)
                        {
                            <tr class="table-success">
                                <td>@Rank.Rank</td>
                                <td>@Rank.ContestantNumber</td>
                                <td>@Rank.Score%</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@Rank.Rank</td>
                                <td>@Rank.ContestantNumber</td>
                                <td>@Rank.Score%</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="col-6 p-0">
        <table class="table table-sm table-bordered text-center" style="margin:auto; width:80%">
            <thead>
                <tr>
                    <th>@localizer["Rank"] @localizer["E"]@localizer["W"]</th>
                    <th>@localizer["PairNumber"]</th>
                    <th>@localizer["PercentageShort"]</th>
                </tr>
            </thead>
            <tbody id="tableBodyEW">
                @foreach (var Rank in Model)
                {
                    if (Rank.Orientation == "E")
                    {
                        if (Model.ContestantNumberEast == Rank.ContestantNumber)
                        {
                            <tr class="table-warning">
                                <td>@Rank.Rank</td>
                                <td>@Rank.ContestantNumber</td>
                                <td>@Rank.Score%</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@Rank.Rank</td>
                                <td>@Rank.ContestantNumber</td>
                                <td>@Rank.Score%</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    var urlPollRanking = '@Url.Action("PollRanking", "ShowRankingList")';
    var urlEndScreen = '@Url.Action("Index", "EndScreen")';
    var urlShowMove = '@Url.Action("Index", "ShowMove")?newRoundNumber=' + (@Model.RoundNumber + 1).toString();
    var urlShowBoards = '@Url.Action("Index", "ShowBoards")';
    var finalRankingList = @Model.FinalRankingList.ToString().ToLower();
    var contestantNumberNorth = @Model.ContestantNumberNorth;
    var contestantNumberEast = @Model.ContestantNumberEast;
</script>
<script src="~/js/TwoWinnersRankingList.js"></script>