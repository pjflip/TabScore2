@if (TempData.ContainsKey("Message") && TempData["Message"] is string message && !string.IsNullOrEmpty(message))
{
    <div id="invalidScorerModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header text-danger">
                    <p class="modal-title text-center">
                        <h3>@localizer["Warning"]</h3>
                    </p>
                </div>
                <div class="modal-body">
                    <p>@localizer[message]</p>
                </div>
                <div class="modal-footer">
                    <button class="btn  btn-lg btn-success" data-bs-dismiss="modal">
                        @localizer["OK"] <span class="icon-check-circle"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        var invalidScorerModal = new bootstrap.Modal(document.getElementById("invalidScorerModal"), { backdrop: 'static' });
        invalidScorerModal.show();
    </script>
}

<div class="row mt-4">
    <div class="col-12 text-center">
        <h2>
            @localizer["SelectScorer"]
        </h2>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12 text-center">
        <button id="scoring" class="btn btn-info" ontouchstart="touchAvailable = true; SelectScoring(true)" onclick="if (!touchAvailable) SelectScoring(true)">
            @localizer["ScoreThisRound"]
        </button>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12 text-center">
        <button id="viewOnly" class="btn btn-outline-info" ontouchstart="touchAvailable = true; SelectScoring(false)" onclick="if (!touchAvailable) SelectScoring(false)">
            @localizer["ViewOnly"]
        </button>
    </div>
</div>

<script>
    var scoring = false;
    var isSubmitted = false;

    function SelectScoring(isScoring) {
        scoring = isScoring;
        if (scoring) {
            document.getElementById("viewOnly").className = "btn btn-outline-info";
            document.getElementById("scoring").className = "btn btn-warning";
        }
        else {
            document.getElementById("viewOnly").className = "btn btn-warning";
            document.getElementById("scoring").className = "btn btn-info";
        }
        document.getElementById("OKButton").disabled = false;
    }

    function OKButtonClick() {
        if (document.getElementById("OKButton").disabled) return;
        if (!isSubmitted) {
            isSubmitted = true;
            if (scoring) {
                location.href = '@Url.Action("ScoreThisRoundButtonClick", "SelectScorer")';
            }
            else {
                location.href = '@Url.Action("ViewOnlyButtonClick", "SelectScorer")';
            }
        }
    }
</script>
