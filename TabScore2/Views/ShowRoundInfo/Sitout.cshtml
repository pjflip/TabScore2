@model ShowRoundInfoSitoutModel

<div class="row mt-4">
    <div class="col-12 text-center">
        <h2>
            @localizer["Round"] @Model.RoundNumber
        </h2>
    </div>
</div>

@if (Model.TabletDevicesPerTable == 2)
{
    <div class="row mt-4">
        <div class="col-12 text-center">
            <h3 style="color:blue">
                @localizer["Pair"] @Model.ContestantNumber
            </h3>
        </div>
    </div>
}
else
{
    <div class="row mt-4">
        <div class="col-12 text-center">
            <h3 style="color:blue">
                @localizer["Player"] @Model.ContestantNumber
            </h3>
        </div>
    </div>
}

<div class="row mt-4">
    <div class="col-12 text-center">
        <h3 style="color:red">
            @localizer["SittingOut"]
        </h3>
    </div>
</div>

<div class="row">
    <div class="col-1">
    </div>
    <div class="col-10 text-center">
        <h5>
            @localizer["SittingOutNoTable"]
        </h5>
    </div>
    <div class="col-1">
    </div>
</div>

<script>
    var isSubmitted = false;

    function OKButtonClick() {
        if (document.getElementById("OKButton").disabled) return;
        if (!isSubmitted) {
            isSubmitted = true;
            location.href = '@Url.Action("Index", "ShowRankingList")';
        }
    }

    function BackButtonClick() {
        if (document.getElementById("BackButton").disabled) return;
        if (!isSubmitted) {
            isSubmitted = true;
            location.href = '@Url.Action("BackButtonClick", "ShowRoundInfo")';
        }
    }
</script>

