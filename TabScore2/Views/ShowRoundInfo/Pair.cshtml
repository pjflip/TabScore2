@model ShowRoundInfoModel

@if (TempData.ContainsKey("Message") && TempData["Message"] is string message && !string.IsNullOrEmpty(message))
{
    <div id="invalidScorerModal" class="modal fade">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header text-danger">
                    <p class="modal-title text-center">
                        <h3>@localizer["Warning"]</h3>
                    </p>
                </div>
                <div class="modal-body">
                    <p>@localizer[message]</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success" data-bs-dismiss="modal">
                        @localizer["OK"] <span class="icon-check-circle"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        var invalidScorerModal = new bootstrap.Modal(document.getElementById("invalidScorerModal"), { backdrop: 'static' });
        invalidScorerModal.show();
    </script>
}

<div class="row mt-4">
    <div class="col-12 text-center">
        <h2>
            @localizer["Round"] @Model.RoundNumber
        </h2>
    </div>
</div>

<div class="row">
    <div class="col-12 text-center">
        @if (Model.LowBoard == Model.HighBoard)
        {
            <h3 style="color:green">
                @localizer["Board"] @Model.LowBoard
            </h3>
        }
        else
        {
            <h3 style="color:green">
                @localizer["Boards"] @Model.LowBoard - @Model.HighBoard
            </h3>
        }
        @if (Model.BoardsFromTable == 0)
        {
            <h6>
                [ @localizer["FromRelayTable"] ]
            </h6>
        }
        else if (Model.BoardsFromTable > 0)
        {
            <h6>
                [ @localizer["FromTable"] @Model.BoardsFromTable ]
            </h6>
        }
    </div>
</div>


@if (!Model.NSMissing)
{
    <div class="row mt-4">
        <div class="col-12 text-center">
            <h3 style="color:blue">
                @localizer["North"]/@localizer["South"]: @Model.NumberNorth
            </h3>
        </div>
    </div>

    <div class="row">
        <div class="col-12 text-center">
            <h4>
                @Model.DisplayNameNorth & @Model.DisplayNameSouth
            </h4>
        </div>
    </div>
}

@if (!Model.EWMissing)
{
    <div class="row mt-4">
        <div class="col-12 text-center">
            <h3 style="color:blue">
                @localizer["East"]/@localizer["West"]: @Model.NumberEast
            </h3>
        </div>
    </div>

    <div class="row">
        <div class="col-12 text-center">
            <h4>
                @Model.DisplayNameEast & @Model.DisplayNameWest
            </h4>
        </div>
    </div>
}

@if (Model.NSMissing || Model.EWMissing)
{
    <div class="row mt-4">
        <div class="col-12 text-center">
            <h3 style="color:red">
                @localizer["SittingOut"]
            </h3>
        </div>
    </div>
}

@if (Model.ShowScorerButtons)
{
    <div class="row mt-4">
        <div class="col-12 text-center">
            <button id="scoreThisRound" class="btn btn-secondary" onclick="ScoreThisRoundButtonClick()">
                @localizer["ScoreThisRound"]
            </button>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-12 text-center">
            <button id="viewOnly" class="btn btn-outline-secondary" onclick="ViewOnlyButtonClick()">
                @localizer["ViewOnly"]
            </button>
        </div>
    </div>
}

<script>
    var urlOKButtonClick = '@Url.Action("OKButtonClick", "ShowRoundInfo")';
    var urlBackButtonClick = '@Url.Action("BackButtonClick", "ShowRoundInfo")';
    var urlScoreThisRoundButtonClick = '@Url.Action("ScoreThisRoundButtonClick", "ShowRoundInfo")';
    var urlViewOnlyButtonClick = '@Url.Action("ViewOnlyButtonClick", "ShowRoundInfo")';
</script>
<script src="~/js/ShowRoundInfo.js"></script>